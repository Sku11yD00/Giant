<!-- The editor's chat with Claude. Editor only: it is never part of a game
     (a game holds no key and talks to no one). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Giant.Chat</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Listed in third_party/README.md, with what it brings along. -->
    <PackageReference Include="Anthropic" Version="[13.10.0]" />
    <InternalsVisibleTo Include="ChatTests" />
    <!-- The SDK's licence goes wherever the SDK does (the editor download). -->
    <None Include="licenses/Microsoft.Extensions.AI.Abstractions.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)anthropic/13.10.0/LICENSE" Link="licenses/Anthropic.LICENSE.txt" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
