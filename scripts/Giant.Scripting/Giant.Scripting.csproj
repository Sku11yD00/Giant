<Project Sdk="Microsoft.NET.Sdk">
  <!-- The engine's C# API, loaded by the native script host. Game scripts
       reference this assembly and nothing else from the engine. -->
  <PropertyGroup>
    <RootNamespace>Giant</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The native host starts the runtime from this file. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
