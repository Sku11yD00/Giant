# Shaders: Slang source compiled at build time and embedded in the module
# that uses them, so executables need no shader files next to them.
#
# giant_shaders(<module> [TARGET <target>]
#   SHADERS <file.slang>:<entry>:<stage>:<name> ...)
#
# TARGET defaults to giant_<module>; tests pass their test executable.
#
# Generates <module>_shaders.h with one function per shader,
#   std::span<const std::uint8_t> giant::shaders::<name>();
# returning the GPU bytecode for this platform's backend (DXIL on Windows).
# Where shaders are not compiled (see GIANT_COMPILE_SHADERS) the spans are
# empty; on Linux CI they are still compiled, to HLSL, to catch errors.

set(GIANT_SHADER_EMBED_SCRIPT ${CMAKE_CURRENT_LIST_DIR}/embed_file.cmake)

function(giant_shaders module)
  cmake_parse_arguments(ARG "" "TARGET" "SHADERS" ${ARGN})
  set(target giant_${module})
  if(ARG_TARGET)
    set(target ${ARG_TARGET})
  endif()
  set(out_dir ${CMAKE_CURRENT_BINARY_DIR}/shaders)
  set(header ${out_dir}/${module}_shaders.h)
  set(declarations "")
  set(sources "")
  foreach(spec IN LISTS ARG_SHADERS)
    string(REPLACE ":" ";" parts "${spec}")
    list(LENGTH parts count)
    if(NOT count EQUAL 4)
      message(FATAL_ERROR "giant_shaders: '${spec}' must be file:entry:stage:name")
    endif()
    list(GET parts 0 file)
    list(GET parts 1 entry)
    list(GET parts 2 stage)
    list(GET parts 3 name)
    set(src ${CMAKE_CURRENT_SOURCE_DIR}/${file})
    set(blob ${out_dir}/${name}.bin)
    set(cpp ${out_dir}/${name}.cpp)
    if(GIANT_COMPILE_SHADERS)
      if(WIN32)
        set(slang_target dxil)
        set(compiled ${blob})
      else()
        set(slang_target hlsl)
        set(compiled ${out_dir}/${name}.check.hlsl)
      endif()
      add_custom_command(
        OUTPUT ${compiled}
        COMMAND ${GIANT_SLANGC} ${src} -target ${slang_target} -profile sm_6_6
                -entry ${entry} -stage ${stage} -O3 -warnings-as-errors all
                -I ${PROJECT_SOURCE_DIR}/engine/rhi/shaders
                -o ${compiled} -depfile ${compiled}.d
        DEPFILE ${compiled}.d
        DEPENDS ${src} ${GIANT_SLANGC}
        COMMENT "Slang: ${file} (${entry})"
        VERBATIM)
      if(NOT WIN32)
        # Checked only: nothing to embed for the null backend.
        add_custom_command(
          OUTPUT ${blob}
          COMMAND ${CMAKE_COMMAND} -E rm -f ${blob}
          COMMAND ${CMAKE_COMMAND} -E touch ${blob}
          DEPENDS ${compiled}
          VERBATIM)
      endif()
    else()
      # Empty, even if an earlier build with shaders on left DXIL here.
      add_custom_command(
        OUTPUT ${blob}
        COMMAND ${CMAKE_COMMAND} -E rm -f ${blob}
        COMMAND ${CMAKE_COMMAND} -E touch ${blob}
        DEPENDS ${src}
        VERBATIM)
    endif()
    add_custom_command(
      OUTPUT ${cpp}
      COMMAND ${CMAKE_COMMAND} -DINPUT=${blob} -DOUTPUT=${cpp} -DNAME=${name}
              -P ${GIANT_SHADER_EMBED_SCRIPT}
      DEPENDS ${blob} ${GIANT_SHADER_EMBED_SCRIPT}
      VERBATIM)
    string(APPEND declarations "std::span<const std::uint8_t> ${name}();\n")
    list(APPEND sources ${cpp})
  endforeach()
  file(WRITE ${header}.in
    "// Generated by giant_shaders() from ${CMAKE_CURRENT_LIST_FILE}; do not edit.\n"
    "#pragma once\n\n#include <cstdint>\n#include <span>\n\n"
    "namespace giant::shaders {\n\n${declarations}\n} // namespace giant::shaders\n")
  configure_file(${header}.in ${header} COPYONLY)
  target_sources(${target} PRIVATE ${sources})
  target_include_directories(${target} PRIVATE ${out_dir})
endfunction()
